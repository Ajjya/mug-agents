# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017
# Development databases must end in _dev (npm run reset-dev-db refuses anything else).
MONGODB_DB=mug_agents_dev
LOG_LEVEL=info

# --- LLM (M1): Ollama Cloud. The key is a secret: put the real value only in .env ---
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_MAX_CONCURRENCY=3
# Ordered cheapest -> strongest; the planner climbs it on validation failures.
LLM_MODEL_LADDER=ollama:gemma4:31b,ollama:gpt-oss:20b,ollama:mistral-large-4
# Price per 1M tokens, by model ref. Never hard-coded; check your plan.
LLM_PRICES={"ollama:gpt-oss:20b":{"inputPerMTok":0.07,"outputPerMTok":0.3}}
LLM_TIMEOUT_MS=60000
# Default: 2 x ladder length. Must let every rung be reached (3 rungs need >= 5).
LLM_MAX_ATTEMPTS=6

# --- Approvals and checkpoints (M2) ---
# Days a FINISHED thread's checkpoints are kept. Paused or failed threads never expire.
CHECKPOINT_TTL_DAYS=30
# Who a decision is recorded as when `approvals` is run without --by (no auth yet: recorded as given).
# APPROVER_NAME=vlad

# --- Retrieval (M3): embeddings are LOCAL only (ollama serve + ollama pull nomic-embed-text) ---
OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
RETRIEVAL_STORE=bruteforce
VECTOR_MIN_SCORE=0.575
VECTOR_MIN_GAP=0.05
KEYWORD_MIN_COVERAGE=0.5

# Speakers agent (M3b)
CHASE_MAX_ROUNDS=2
CHASE_MIN_INTERVAL_DAYS=7
MAX_DRAFTS_PER_RUN=10
EVENT_TIME_ZONE=Europe/Lisbon
# ATLAS_LOCAL_URI=mongodb://127.0.0.1:27018/?directConnection=true

# Inbox (M4a): reading only. The two labels are REQUIRED to start the inbox and have no default:
# GMAIL_LABEL admits mail (bodies read, triaged, linked); GMAIL_CANDIDATE_LABEL is metadata only.
# They must differ. Create both in Gmail and apply them with filters (or by hand) first.
GMAIL_LABEL=
GMAIL_CANDIDATE_LABEL=
# Gmail over IMAP with an APP PASSWORD (README, "Inbox"): a secret, never committed, never logged.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=
TRIAGE_START_MODEL=ollama:gpt-oss:20b
TRIAGE_MAX_CHARS=6000
GMAIL_SWEEP_MAX_PAGES=20
GMAIL_SWEEP_PAGE_SIZE=200
