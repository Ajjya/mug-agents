# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017
# Development databases must end in _dev (npm run reset-dev-db refuses anything else).
MONGODB_DB=mug_agents_dev
LOG_LEVEL=info

# --- LLM (M1): Ollama Cloud. The key is a secret: put the real value only in .env ---
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_MAX_CONCURRENCY=3
# Ordered cheapest -> strongest; the planner climbs it on validation failures.
LLM_MODEL_LADDER=ollama:gemma4:31b,ollama:gpt-oss:20b,ollama:mistral-large-4
# Price per 1M tokens, by model ref. Never hard-coded; check your plan.
LLM_PRICES={"ollama:gpt-oss:20b":{"inputPerMTok":0.07,"outputPerMTok":0.3}}
LLM_TIMEOUT_MS=60000
# Default: 2 x ladder length. Must let every rung be reached (3 rungs need >= 5).
LLM_MAX_ATTEMPTS=6
